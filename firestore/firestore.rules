rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function validGame(gameId) {
      return gameId in ['zip', 'path_words', 'sudoku'];
    }

    function validTimeSeconds() {
      return request.resource.data.timeSeconds is int
        && request.resource.data.timeSeconds > 0;
    }

    function improvingTime() {
      return validTimeSeconds()
        && request.resource.data.timeSeconds < resource.data.timeSeconds;
    }

    // Allow only expected score fields on leaderboard docs.
    function validLeaderboardKeys() {
      return request.resource.data.keys().hasOnly([
        'timeSeconds',
        'updatedAt',
        'displayName',
        'photoUrl',
        'avatarId',
        'usedHints',
        'hadMistakes',
        'currentStreak',
      ]) && validCurrentStreak()
        && validLeaderboardIdentity()
        && validLeaderboardUpdatedAt();
    }

    // Leaderboard identity is public, so keep it small, and point photos only
    // at Google account photos or our R2 avatars: any other host would see the
    // IP address of everyone who opens the board. The client trims names to
    // 40 characters and drops other photo URLs; the host pattern must match
    // leaderboardPhotoHostsPattern in lib/data/leaderboard_identity.dart
    // (test/firestore/rules_leaderboard_identity_test.dart pins both).
    function validLeaderboardIdentity() {
      let data = request.resource.data;
      return (!('displayName' in data)
          || (data.displayName is string
            && data.displayName.size() > 0
            && data.displayName.size() <= 120))
        && (!('photoUrl' in data)
          || data.photoUrl == null
          || (data.photoUrl is string
            && data.photoUrl.size() <= 2048
            && data.photoUrl.matches('^https://([a-z0-9-]+[.]googleusercontent[.]com|pub-94fd8286c7fa4508a0e988821039d2a8[.]r2[.]dev/avatars)/.*$')))
        && (!('avatarId' in data)
          || data.avatarId == null
          || (data.avatarId is string && data.avatarId.size() <= 64));
    }

    // updatedAt breaks ties between equal times, so it is either the server
    // time of this write or left as it was (identity refreshes omit it).
    function validLeaderboardUpdatedAt() {
      let data = request.resource.data;
      return ('updatedAt' in data && data.updatedAt == request.time)
        || (resource != null
          && 'updatedAt' in resource.data
          && 'updatedAt' in data
          && data.updatedAt == resource.data.updatedAt)
        || (resource != null
          && !('updatedAt' in resource.data)
          && !('updatedAt' in data));
    }

    // Optional; older clients (<= 1.0.0+13) never write it.
    function validCurrentStreak() {
      return !request.resource.data.keys().hasAny(['currentStreak'])
        || (request.resource.data.currentStreak is int
          && request.resource.data.currentStreak >= 0);
    }

    function validCleanRunFlags() {
      return request.resource.data.usedHints is bool
        && request.resource.data.hadMistakes is bool;
    }

    // Identity / streak refresh that does not change the recorded time.
    // [streakMayChange] is false on the release boards once direct writes
    // are off (fair-play phase 2): only the Worker can check a streak.
    function profileOnlyLeaderboardUpdate(streakMayChange) {
      return request.resource.data.timeSeconds == resource.data.timeSeconds
        && validCurrentStreak()
        && validLeaderboardIdentity()
        && validLeaderboardUpdatedAt()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(streakMayChange
              ? ['displayName', 'photoUrl', 'avatarId', 'updatedAt',
                'currentStreak']
              : ['displayName', 'photoUrl', 'avatarId', 'updatedAt']);
    }

    // Fair play. From 1.1.0+19 the app submits through the leaderboard
    // Worker (workers/leaderboard), which checks the clear and writes with
    // admin credentials, so these rules don't apply to it. Older builds still
    // write directly, so phase 1 keeps direct writes open, with a minimum time
    // and a live day. Phase 2, once minBuildNumber reaches 19: return false
    // here and deploy the rules; only identity refreshes stay open.
    function directLeaderboardWritesAllowed() {
      return true;
    }

    // Fastest accepted clear per game, in seconds. MIN_SECONDS in
    // workers/leaderboard/src/limits.ts and leaderboardMinSeconds in
    // lib/domain/leaderboard_limits.dart are the same numbers
    // (test/firestore/leaderboard_fair_play_pins_test.dart pins all three).
    function minLeaderboardSeconds(gameId) {
      return {'zip': 3, 'path_words': 15, 'sudoku': 15}[gameId];
    }

    function meetsMinimumTime(gameId) {
      return request.resource.data.timeSeconds >= minLeaderboardSeconds(gameId);
    }

    // UTC midnight of a yyyy-MM-dd day id.
    function utcMidnightOf(dayId) {
      let parts = dayId.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }

    // A leaderboard day is the phone's local date, so its board is open from
    // 10:00 UTC the day before (00:00 at UTC+14) to 12:00 UTC the day after
    // (24:00 at UTC-12). isDayLive in workers/leaderboard/src/days.ts.
    function leaderboardDayIsLive(dayId) {
      return dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time >= utcMidnightOf(dayId) - duration.value(14, 'h')
        && request.time < utcMidnightOf(dayId) + duration.value(36, 'h');
    }

    // A `daily_YYYYMMDD` puzzle holds its solution, so players can read it
    // only once its day is live somewhere (10:00 UTC the day before, the rule
    // in winklo-admin's daily_live.ts). Admins can read it at any time. Other
    // ids are unchanged.
    function puzzleDocReadable(id) {
      return !id.matches('^daily_[0-9]{8}$')
        || isAdmin()
        || request.time >= timestamp.date(
            int(id[6:10]), int(id[10:12]), int(id[12:14])
          ) - duration.value(14, 'h');
    }

    // users/{uid}.avatarId is an optional string (null clears a preset).
    function validUserAvatarId() {
      return !request.resource.data.keys().hasAny(['avatarId'])
        || request.resource.data.avatarId == null
        || request.resource.data.avatarId is string;
    }

    match /zip_levels/{id} {
      allow get: if puzzleDocReadable(id);
      // A query could return a daily before it's live; only admins list.
      allow list: if isAdmin();
      allow write: if false;
    }
    match /path_words_levels/{id} {
      allow get: if puzzleDocReadable(id);
      // A query could return a daily before it's live; only admins list.
      allow list: if isAdmin();
      allow write: if false;
    }
    match /sudoku_levels/{id} {
      allow get: if puzzleDocReadable(id);
      // A query could return a daily before it's live; only admins list.
      allow list: if isAdmin();
      allow write: if false;
    }
    match /word_match_decks/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Profiles hold each phone's push token (fcmToken), so only the owner (or
    // an admin) reads them. Leaderboard docs carry the public name and photo.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && validUserAvatarId();
      allow delete: if false;
    }

    // Private per-user progress (owner-only). Clients write with
    // set(merge: true), so request.resource.data is the merged doc and these
    // checks validate the whole stored doc on create and update alike.
    // Key whitelists must equal gameDayFirestoreKeys / streakFirestoreKeys in
    // lib/data/repositories/progress_remote_repository_impl.dart.
    function validOptionalNonNegativeInt(data, key) {
      return !(key in data) || (data[key] is int && data[key] >= 0);
    }

    function validOptionalBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function validGameDay(dayKey) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'gameId', 'playId', 'timeSeconds', 'points', 'usedHints',
          'hadMistakes', 'flagsKnown', 'hintsUsed', 'clearedAt', 'board',
          'updatedAt'
        ])
        && data.gameId is string
        && validGame(data.gameId)
        && data.playId is string
        && data.playId.matches('^[0-9]{8}([0-9]{4})?$')
        && dayKey == data.gameId + '_' + data.playId
        && validOptionalNonNegativeInt(data, 'timeSeconds')
        && validOptionalNonNegativeInt(data, 'points')
        && validOptionalBool(data, 'usedHints')
        && validOptionalBool(data, 'hadMistakes')
        && validOptionalBool(data, 'flagsKnown')
        && data.hintsUsed is int
        && data.hintsUsed >= 0
        && data.hintsUsed <= 50
        && (!('clearedAt' in data) || data.clearedAt is timestamp)
        && (!('board' in data)
          || (data.board is string
            && data.board.size() > 0
            && data.board.size() <= 1024
            && 'timeSeconds' in data))
        && data.updatedAt == request.time
        && (resource == null || gameDayDoesNotRegress(data, resource.data));
    }

    // The client merges a read with its local copy before the merge write;
    // that is not a transaction (and offline the read is the cache), so a
    // stale write could regress another device's better result. Updates may
    // only improve: a rejected write is rolled back and the next sync run
    // re-merges against the server copy.
    function gameDayDoesNotRegress(data, stored) {
      return (!('timeSeconds' in stored)
          || ('timeSeconds' in data && data.timeSeconds <= stored.timeSeconds))
        && (!('points' in stored)
          || ('points' in data && data.points >= stored.points))
        && (!('hintsUsed' in stored) || data.hintsUsed >= stored.hintsUsed)
        && (!('clearedAt' in stored)
          || ('clearedAt' in data && data.clearedAt <= stored.clearedAt))
        // The board belongs to the best-time run: it only changes with a
        // strictly better time.
        && (!('board' in stored)
          || ('board' in data && data.board == stored.board)
          || ('timeSeconds' in data && 'timeSeconds' in stored
            && data.timeSeconds < stored.timeSeconds));
    }

    // freezeCount (banked freezes, 0-2) is optional: older builds write only
    // freezeAvailable, which new builds keep writing as freezeCount > 0.
    function validGameStreak(gameId) {
      let data = request.resource.data;
      return validGame(gameId)
        && data.keys().hasOnly([
          'current', 'longest', 'lastClearedDateId', 'freezeAvailable',
          'freezeCount', 'updatedAt'
        ])
        && data.current is int
        && data.current >= 0
        && data.longest is int
        && data.longest >= 0
        && (data.lastClearedDateId == null
          || (data.lastClearedDateId is string
            && data.lastClearedDateId.matches('^[0-9]{8}$')))
        && data.freezeAvailable is bool
        && (!('freezeCount' in data) || (data.freezeCount is int
          && data.freezeCount >= 0 && data.freezeCount <= 2))
        && data.updatedAt == request.time
        && (resource == null || gameStreakDoesNotRegress(data, resource.data));
    }

    // A streak may reset (current goes down), but never move back to an
    // earlier last clear day or lose its longest; see gameDayDoesNotRegress.
    function gameStreakDoesNotRegress(data, stored) {
      return (!('longest' in stored) || data.longest >= stored.longest)
        && (!('lastClearedDateId' in stored)
          || stored.lastClearedDateId == null
          || (data.lastClearedDateId != null
            && data.lastClearedDateId >= stored.lastClearedDateId));
    }

    match /users/{uid}/game_days/{dayKey} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validGameDay(dayKey);
      allow delete: if false;
    }

    match /users/{uid}/game_streaks/{gameId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validGameStreak(gameId);
      allow delete: if false;
    }

    // Twins used by debug builds (`kDebugMode`), like `leaderboards_debug`.
    match /users/{uid}/game_days_debug/{dayKey} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validGameDay(dayKey);
      allow delete: if false;
    }

    match /users/{uid}/game_streaks_debug/{gameId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validGameStreak(gameId);
      allow delete: if false;
    }

    // Public read so the board loads even if the Auth ID token is still
    // refreshing; writes stay owner-only + improve-only, and (fair play)
    // need the game's minimum time while direct writes are allowed at all.
    match /leaderboards/{gameId}/all_time/{uid} {
      allow read: if validGame(gameId);
      allow create: if directLeaderboardWritesAllowed()
        && isOwner(uid)
        && validGame(gameId)
        && validTimeSeconds()
        && meetsMinimumTime(gameId)
        && validLeaderboardKeys()
        && validCleanRunFlags();
      allow update: if isOwner(uid)
        && validGame(gameId)
        && (
          (directLeaderboardWritesAllowed()
            && improvingTime()
            && meetsMinimumTime(gameId)
            && validLeaderboardKeys()
            && validCleanRunFlags())
          || profileOnlyLeaderboardUpdate(directLeaderboardWritesAllowed())
        );
      allow delete: if false;
    }

    // Daily boards also need a yyyy-MM-dd day that is live right now.
    match /leaderboards/{gameId}/daily/{dayId}/entries/{uid} {
      allow read: if validGame(gameId);
      allow create: if directLeaderboardWritesAllowed()
        && isOwner(uid)
        && validGame(gameId)
        && leaderboardDayIsLive(dayId)
        && validTimeSeconds()
        && meetsMinimumTime(gameId)
        && validLeaderboardKeys()
        && validCleanRunFlags();
      allow update: if isOwner(uid)
        && validGame(gameId)
        && leaderboardDayIsLive(dayId)
        && (
          (directLeaderboardWritesAllowed()
            && improvingTime()
            && meetsMinimumTime(gameId)
            && validLeaderboardKeys()
            && validCleanRunFlags())
          || profileOnlyLeaderboardUpdate(directLeaderboardWritesAllowed())
        );
      allow delete: if false;
    }

    // Weekly totals: only the leaderboard Worker writes them.
    match /leaderboards/{gameId}/weekly/{weekId}/entries/{uid} {
      allow read: if validGame(gameId);
      allow write: if false;
    }

    // Twin used by debug builds (`kDebugMode`) so demo seeds / local
    // submits never touch production `leaderboards`.
    match /leaderboards_debug/{gameId}/all_time/{uid} {
      allow read: if validGame(gameId);
      allow create: if isOwner(uid)
        && validGame(gameId)
        && validTimeSeconds()
        && validLeaderboardKeys()
        && validCleanRunFlags();
      allow update: if isOwner(uid)
        && validGame(gameId)
        && (
          (improvingTime() && validLeaderboardKeys() && validCleanRunFlags())
          || profileOnlyLeaderboardUpdate(true)
        );
      allow delete: if false;
    }

    match /leaderboards_debug/{gameId}/daily/{dayId}/entries/{uid} {
      allow read: if validGame(gameId);
      allow create: if isOwner(uid)
        && validGame(gameId)
        && validTimeSeconds()
        && validLeaderboardKeys()
        && validCleanRunFlags();
      allow update: if isOwner(uid)
        && validGame(gameId)
        && (
          (improvingTime() && validLeaderboardKeys() && validCleanRunFlags())
          || profileOnlyLeaderboardUpdate(true)
        );
      allow delete: if false;
    }

    // Private leagues. A league doc lists its members' uids (1 to 30), and
    // league_codes/{CODE} points an invite code at it. Anyone signed in can
    // get either by id, which is how a code is joined, but not list them;
    // members list their own leagues with array-contains. Field list:
    // leagueFirestoreKeys in lib/data/repositories/league_repository_impl.dart.
    function validLeagueCode(code) {
      return code is string
        && code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$');
    }

    function validLeagueName(name) {
      return name is string
        && name.size() >= 1
        && name.size() <= 30
        && name.trim().size() > 0;
    }

    function leagueDoc(leagueId) {
      return /databases/$(database)/documents/leagues/$(leagueId);
    }

    function leagueCodeDoc(code) {
      return /databases/$(database)/documents/league_codes/$(code);
    }

    // The owner is the only member, and the code doc that points here is
    // written in the same batch.
    function validLeagueCreate(leagueId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name', 'ownerUid', 'code', 'memberUids', 'createdAt'
        ])
        && data.keys().hasAll([
          'name', 'ownerUid', 'code', 'memberUids', 'createdAt'
        ])
        && validLeagueName(data.name)
        && data.ownerUid == request.auth.uid
        && data.memberUids == [request.auth.uid]
        && validLeagueCode(data.code)
        && data.createdAt == request.time
        && getAfter(leagueCodeDoc(data.code)).data.leagueId == leagueId;
    }

    function onlyMembersChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['memberUids']);
    }

    // Joining adds your own uid and nothing else; a league holds 30 at most.
    function joinsLeague() {
      let before = resource.data.memberUids;
      let after = request.resource.data.memberUids;
      return onlyMembersChange()
        && !(request.auth.uid in before)
        && after is list
        && after.size() == before.size() + 1
        && after.hasAll(before)
        && request.auth.uid in after
        && after.size() <= 30;
    }

    // Leaving removes your own uid and nothing else. The owner can't leave
    // (they delete the league instead), so a league always has its owner.
    function leavesLeague() {
      let before = resource.data.memberUids;
      let after = request.resource.data.memberUids;
      return onlyMembersChange()
        && request.auth.uid != resource.data.ownerUid
        && request.auth.uid in before
        && after is list
        && after.size() == before.size() - 1
        && before.hasAll(after)
        && !(request.auth.uid in after);
    }

    function isLeagueOwner() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // The owner removes other players; they stay in themselves.
    function ownerRemovesMembers() {
      let before = resource.data.memberUids;
      let after = request.resource.data.memberUids;
      return isLeagueOwner()
        && onlyMembersChange()
        && after is list
        && after.size() < before.size()
        && before.hasAll(after)
        && request.auth.uid in after;
    }

    function ownerRenamesLeague() {
      return isLeagueOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name'])
        && validLeagueName(request.resource.data.name);
    }

    match /leagues/{leagueId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn() && validLeagueCreate(leagueId);
      allow update: if isSignedIn()
        && (joinsLeague()
          || leavesLeague()
          || ownerRemovesMembers()
          || ownerRenamesLeague());
      // With its code doc in the same batch, so no code is left pointing
      // nowhere (its own delete rule reads the league).
      allow delete: if isLeagueOwner()
        && !existsAfter(leagueCodeDoc(resource.data.code));
    }

    match /league_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      // Only alongside a new league of yours that carries this code.
      allow create: if isSignedIn()
        && validLeagueCode(code)
        && request.resource.data.keys().hasOnly(['leagueId'])
        && request.resource.data.leagueId is string
        && !exists(leagueDoc(request.resource.data.leagueId))
        && getAfter(leagueDoc(request.resource.data.leagueId)).data.code == code
        && getAfter(leagueDoc(request.resource.data.leagueId)).data.ownerUid
          == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
        && get(leagueDoc(resource.data.leagueId)).data.ownerUid
          == request.auth.uid;
    }

    match /issue_reports/{reportId} {
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'uid', 'displayName', 'photoUrl',
          'avatarId', 'appVersion', 'buildNumber', 'platform', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.uid is string
        && request.resource.data.displayName is string
        && (request.resource.data.photoUrl == null
            || request.resource.data.photoUrl is string)
        && (request.resource.data.avatarId == null
            || request.resource.data.avatarId is string)
        && request.resource.data.appVersion is string
        && request.resource.data.buildNumber is string
        && request.resource.data.platform is string
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /deletion_requests/{id} {
      allow read, write: if false;
    }

    // Automatic client telemetry (not user-submitted issue reports).
    match /client_errors/{id} {
      allow create: if validClientErrorCreate();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    function validClientErrorSeverity() {
      return request.resource.data.severity in ['error', 'fatal'];
    }

    function validClientErrorSource() {
      return request.resource.data.source in [
        'handled', 'flutter', 'platform', 'bloc'
      ];
    }

    function validClientErrorUid() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == null
        || (
          request.resource.data.uid is string
          && request.resource.data.uid.size() > 0
          && request.resource.data.uid.size() <= 128
          && isSignedIn()
          && request.auth.uid == request.resource.data.uid
        );
    }

    function validClientErrorCreate() {
      return request.resource.data.keys().hasOnly([
          'createdAt', 'severity', 'source', 'code', 'message',
          'cause', 'stack', 'screen', 'function', 'uid',
          'appVersion', 'buildNumber', 'platform', 'locale'
        ])
        && validClientErrorSeverity()
        && validClientErrorSource()
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && (!('cause' in request.resource.data)
            || request.resource.data.cause == null
            || (request.resource.data.cause is string
                && request.resource.data.cause.size() <= 500))
        && (!('stack' in request.resource.data)
            || request.resource.data.stack == null
            || (request.resource.data.stack is string
                && request.resource.data.stack.size() <= 4000))
        && (!('screen' in request.resource.data)
            || request.resource.data.screen == null
            || (request.resource.data.screen is string
                && request.resource.data.screen.size() <= 120))
        && (!('function' in request.resource.data)
            || request.resource.data.function == null
            || (request.resource.data.function is string
                && request.resource.data.function.size() <= 160))
        && validClientErrorUid()
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() > 0
        && request.resource.data.appVersion.size() <= 32
        && request.resource.data.buildNumber is string
        && request.resource.data.buildNumber.size() > 0
        && request.resource.data.buildNumber.size() <= 16
        && request.resource.data.platform is string
        && request.resource.data.platform.size() > 0
        && request.resource.data.platform.size() <= 32
        && (!('locale' in request.resource.data)
            || request.resource.data.locale == null
            || (request.resource.data.locale is string
                && request.resource.data.locale.size() <= 32))
        && request.resource.data.createdAt == request.time;
    }

    // A clear the leaderboard refused, so the admin sees who was left off a
    // board and why (FirestoreLeaderboardSkipLog in the app). One doc per
    // player, game and day; a later refusal replaces it.
    match /leaderboard_skips/{skipId} {
      allow create, update: if validLeaderboardSkip(skipId);
      allow read: if isAdmin();
      allow delete: if false;
    }

    // Keys: leaderboardSkipFirestoreKeys in the app; reasons: the
    // LeaderboardSubmitRefused codes that can be final
    // (test/firestore/rules_key_whitelist_test.dart pins both).
    function validLeaderboardSkip(skipId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid', 'gameId', 'dayId', 'timeSeconds', 'reason', 'usedHints',
          'hadMistakes', 'displayName', 'photoUrl', 'avatarId', 'appVersion',
          'buildNumber', 'platform', 'createdAt'
        ])
        && isOwner(data.uid)
        && validGame(data.gameId)
        && data.dayId is string
        && leaderboardSkipDayIsRecent(data.dayId)
        && skipId == data.uid + '_' + data.gameId + '_' + data.dayId
        && data.timeSeconds is int
        && data.timeSeconds > 0
        && data.reason in [
          'too_fast', 'too_slow', 'not_live', 'permission_denied',
          'bad_request', 'bad_proof', 'unknown_puzzle'
        ]
        && data.usedHints is bool
        && data.hadMistakes is bool
        && validLeaderboardIdentity()
        && data.appVersion is string
        && data.appVersion.size() <= 32
        && data.buildNumber is string
        && data.buildNumber.size() <= 16
        && data.platform is string
        && data.platform.size() <= 16
        && data.createdAt == request.time;
    }

    // From the day's opening (as leaderboardDayIsLive) to a week after its
    // UTC midnight: a closed day's clear is refused (and logged) on the next
    // sync, and this keeps one player to a few dozen docs.
    function leaderboardSkipDayIsRecent(dayId) {
      return dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time >= utcMidnightOf(dayId) - duration.value(14, 'h')
        && request.time < utcMidnightOf(dayId) + duration.value(7, 'd');
    }

    function validActivityDayId(dayId) {
      return dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validActivityPlatform() {
      return request.resource.data.platform is string
        && request.resource.data.platform in ['ios', 'android', 'other'];
    }

    // Keys of an app-open doc. opens, appVersion, build and installId came in
    // 1.1.x; docs from older builds have only the first four.
    function activityKeys() {
      return ['uid', 'firstOpenAt', 'lastOpenAt', 'platform',
        'opens', 'appVersion', 'build', 'installId'];
    }

    // The same install ID pattern as workers/activity/src/open.ts and
    // lib/data/repositories/activity_install_id.dart.
    function validActivityExtras(data) {
      return (!('opens' in data) || (data.opens is int && data.opens >= 1 && data.opens <= 100000))
        && (!('appVersion' in data) || (data.appVersion is string
          && data.appVersion.matches('^[0-9A-Za-z.+-]{1,32}$')))
        && (!('build' in data) || (data.build is int && data.build >= 0 && data.build <= 10000000))
        && (!('installId' in data) || (data.installId is string
          && data.installId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')));
    }

    function validActivityCreate() {
      return request.resource.data.keys().hasOnly(activityKeys())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.firstOpenAt == request.time
        && request.resource.data.lastOpenAt == request.time
        && validActivityPlatform()
        && validActivityExtras(request.resource.data)
        && (!('opens' in request.resource.data) || request.resource.data.opens == 1);
    }

    // An older build's update leaves opens alone; a newer one counts it up by
    // one. A doc without a count (made by an older build) starts at 1.
    function validActivityUpdate() {
      return request.resource.data.keys().hasOnly(activityKeys())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.firstOpenAt == resource.data.firstOpenAt
        && request.resource.data.lastOpenAt == request.time
        && validActivityPlatform()
        && validActivityExtras(request.resource.data)
        && ('opens' in resource.data
          ? ('opens' in request.resource.data
            && (request.resource.data.opens == resource.data.opens
              || request.resource.data.opens == resource.data.opens + 1))
          : (!('opens' in request.resource.data)
            || request.resource.data.opens == 1));
    }

    match /daily_activity/{dayId}/users/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid)
        && validActivityDayId(dayId)
        && validActivityCreate();
      allow update: if isOwner(uid)
        && validActivityDayId(dayId)
        && validActivityUpdate();
      allow delete: if false;
    }

    // Guests' opens: written only by workers/activity (service account).
    match /daily_activity/{dayId}/guests/{installId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}

