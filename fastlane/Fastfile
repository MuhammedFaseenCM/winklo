default_platform(:android)

platform :android do
  desc "Upload Play Store listing text and graphics (no binary)"
  lane :listing do
    sh("python3", "../play/upload_listing.py")
  end

  aab_path = File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)

  upload_common = {
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: true,
    release_status: "completed"
  }

  desc "Upload a production AAB to the internal testing track"
  lane :internal do
    upload_to_play_store(
      **upload_common,
      track: "internal",
      aab: aab_path,
      changes_not_sent_for_review: true
    )
  end

  desc "Upload a production AAB to closed testing (alpha)"
  lane :closed do
    upload_to_play_store(
      **upload_common.merge(skip_upload_changelogs: false),
      track: "alpha",
      aab: aab_path
    )
  end

  desc "Upload a production AAB to internal and closed testing"
  lane :testing do
    upload_to_play_store(
      **upload_common,
      track: "internal",
      aab: aab_path,
      changes_not_sent_for_review: true
    )
    # Same AAB cannot be re-uploaded; assign the internal version code to closed.
    upload_to_play_store(
      **upload_common,
      track: "alpha",
      skip_upload_apk: true,
      skip_upload_aab: true,
      version_code: google_play_track_version_codes(track: "internal").first
    )
  end
end
