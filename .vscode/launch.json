    "version": "0.2.0",
    "configurations": [
        {
            "name": "winklo",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "winklo (daily play period)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=DAILY_PLAY_PERIOD=true"
            ]
        },
        {
            "name": "winklo (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "winklo (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
